[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Node3D

const CharacterFactory = preload(\"res://scenes/player/character_factory.gd\")
const StructureFactory = preload(\"res://scenes/structures/structure_factory.gd\")
const BeastFactory = preload(\"res://scenes/beasts/beast_factory.gd\")

@onready var camera = $IsometricCamera
@onready var world = $World

var player: CharacterBody3D = null

func _ready() -> void:
	print(\"Forest Thrones — Initializing Match for Archetype: \", GameManager.selected_archetype_id)
	call_deferred(\"_initialize_game_match\")

func _initialize_game_match() -> void:
	# 1. Player spawn — archetype model set inside player.gd _ready() from GameManager
	var player_scene = load(\"res://scenes/player/player.tscn\")
	if player_scene:
		player = player_scene.instantiate()
		player.position = Vector3(-30.0, 0.5, -30.0)
		world.add_child(player)
		if camera:
			camera.target_node = player
			camera.global_position = player.global_position + camera.iso_offset
		# Register 3D player with minimap
		var minimap = get_tree().root.find_child(\"Minimap\", true, false)
		if minimap and minimap.has_method(\"set_player\"):
			minimap.set_player(player)

	# 2. Solid Base Structures (GDD §6 Recommended Build Order — pre-built base)
	_spawn_base_structure(\"hut\",      Vector3(-33.0, 0.0, -33.0))
	_spawn_base_structure(\"cage\",     Vector3(-26.0, 0.0, -33.0))
	_spawn_base_structure(\"treasury\", Vector3(-30.0, 0.0, -35.0))
	_spawn_base_structure(\"fire_pit\", Vector3(-30.0, 0.0, -27.0))

	# 3. Wolf Beast Companion (GDD §11 System 7)
	var wolf := BeastFactory.build_beast(\"wolf\", false)
	wolf.position = Vector3(-28.0, 0.4, -29.0)
	world.add_child(wolf)

	# 4. Traitor Token Assignment (GDD §11 System 1: 6 tokens, 2 clean squads)
	var traitor_sys = get_tree().root.find_child(\"TraitorSystem\", true, false)
	if traitor_sys and traitor_sys.has_method(\"assign_tokens\") and player:
		traitor_sys.assign_tokens([player])

	# 5. Register Squad 1 in CoinSystem economy
	CoinSystem.register_squad(\"squad_1\")

	print(\"Match Initialized: player='\", GameManager.selected_archetype_id,
		  \"' structures=4, beast=wolf, traitor_tokens=assigned, economy=active\")

func _spawn_base_structure(type_key: String, pos: Vector3) -> void:
	var sb := StaticBody3D.new()
	sb.name = \"Base_\" + type_key
	sb.position = pos
	sb.collision_layer = 1
	sb.collision_mask = 1

	var visual = StructureFactory.build_structure(type_key)
	sb.add_child(visual)

	var col_shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	match type_key:
		\"cage\":
			box.size = Vector3(2.3, 2.2, 2.3)
			col_shape.position = Vector3(0, 1.1, 0)
		\"hut\":
			box.size = Vector3(2.6, 2.2, 2.6)
			col_shape.position = Vector3(0, 1.1, 0)
		\"treasury\":
			box.size = Vector3(1.3, 0.9, 0.9)
			col_shape.position = Vector3(0, 0.45, 0)
		_:
			box.size = Vector3(1.6, 1.2, 1.6)
			col_shape.position = Vector3(0, 0.6, 0)

	col_shape.shape = box
	sb.add_child(col_shape)
	world.add_child(sb)
"

[node name="Main" type="Node3D"]
script = SubResource("GDScript_main")

